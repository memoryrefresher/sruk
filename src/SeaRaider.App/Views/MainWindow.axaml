<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SeaRaider.App.ViewModels"
        xmlns:sys="using:System"
        xmlns:views="using:SeaRaider.App.Views"
        xmlns:services="using:SeaRaider.App.Services"
        xmlns:img="clr-namespace:AsyncImageLoader;assembly=AsyncImageLoader.Avalonia"
        x:Class="SeaRaider.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="SeaRaider"
        Icon="/Assets/SeaRaider.ico"
        Width="1380" Height="860" MinWidth="1000" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="44">

  <Window.KeyBindings>
    <!-- Friends & Chat overlay, like Steam's Shift+Tab (Shift+Tab itself moves keyboard focus here). -->
    <KeyBinding Gesture="Ctrl+Shift+F" Command="{Binding Friends.ToggleCommand}" />
  </Window.KeyBindings>

  <Window.Styles>
    <!-- The player overlay: full size over a dark backdrop (the app behind isn't drawn while it plays) … -->
    <Style Selector="Panel#TrailerOverlay">
      <Setter Property="Background" Value="{DynamicResource PlayerBackdropBrush}" />
    </Style>
    <Style Selector="Panel#TrailerOverlay Grid#TrailerLayout">
      <Setter Property="Margin" Value="48,52,48,36" />
    </Style>
    <Style Selector="Panel#TrailerOverlay views|AspectRatioBox#TrailerFrame">
      <Setter Property="ExtraHeight" Value="52" />
      <Setter Property="MaxWidth" Value="1600" />
    </Style>
    <Style Selector="Panel#TrailerOverlay Border#TrailerSlot">
      <Setter Property="CornerRadius" Value="10" />
    </Style>
    <!-- … or the mini-player: shrunk into the bottom-right corner, the app usable around it -->
    <Style Selector="Panel#TrailerOverlay.mini">
      <Setter Property="Background" Value="{x:Null}" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Bottom" />
      <Setter Property="Width" Value="440" />
      <Setter Property="Margin" Value="0,0,24,24" />
    </Style>
    <Style Selector="Panel#TrailerOverlay.mini Grid#TrailerLayout">
      <Setter Property="Margin" Value="0" />
    </Style>
    <Style Selector="Panel#TrailerOverlay.mini views|AspectRatioBox#TrailerFrame">
      <Setter Property="ExtraHeight" Value="36" />
    </Style>
    <Style Selector="Panel#TrailerOverlay.mini Panel#SideArea">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <!-- … or full screen (the video's own full-screen button): only the video, edge to edge -->
    <Style Selector="Panel#TrailerOverlay.fullscreen">
      <Setter Property="Background" Value="Black" />
    </Style>
    <Style Selector="Panel#TrailerOverlay.fullscreen Grid#TrailerLayout">
      <Setter Property="Margin" Value="0" />
    </Style>
    <Style Selector="Panel#TrailerOverlay.fullscreen views|AspectRatioBox#TrailerFrame">
      <Setter Property="ExtraHeight" Value="0" />
      <Setter Property="MaxWidth" Value="100000" />
    </Style>
    <Style Selector="Panel#TrailerOverlay.fullscreen Border#TrailerSlot">
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="Panel#TrailerOverlay.fullscreen Panel#SideArea">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <!-- The chat and bet slip cards beside the video -->
    <Style Selector="Border.side-card">
      <Setter Property="Background" Value="{DynamicResource PlayerCardBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource PlayerCardLineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="Button.player-bar">
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="Margin" Value="8,0,0,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- Behind a coming-soon page, everything is blurred and dimmed. -->
    <Style Selector="Grid#Shell.blurred">
      <Setter Property="Effect">
        <BlurEffect Radius="28" />
      </Setter>
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
  </Window.Styles>

  <!-- Everything sits in RootFade: it starts see-through and MainWindow.axaml.cs fades it in once the window is open. -->
  <Panel x:Name="RootFade" Opacity="0">
  <Panel.Transitions>
    <Transitions>
      <DoubleTransition Property="Opacity" Duration="0:0:1.6" Easing="CubicEaseInOut" />
    </Transitions>
  </Panel.Transitions>
  <!-- Columns: navigation | pages | friends panel (0 wide when closed; opening it widens it and the pages make room). -->
  <Grid x:Name="Shell" ColumnDefinitions="232,*,Auto" RowDefinitions="*,Auto" Classes.blurred="{Binding IsOverlayBlurred}"
        IsVisible="{Binding !IsPlayerCovering}">

    <!-- Backdrop ("The Next Generation" only): the featured game's art, blurred, behind the glass panels. -->
    <Panel Grid.ColumnSpan="3" Grid.RowSpan="2" Classes="backdrop" IsHitTestVisible="False">
      <Image Source="{Binding Backdrop}" Stretch="UniformToFill" Opacity="0.9">
        <Image.Transitions>
          <Transitions>
            <DoubleTransition Property="Opacity" Duration="0:0:0.4" />
          </Transitions>
        </Image.Transitions>
      </Image>
      <Border>
        <Border.Background>
          <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Offset="0" Color="#8C04090F" />
            <GradientStop Offset="0.5" Color="#B304090F" />
            <GradientStop Offset="1" Color="#E604090F" />
          </LinearGradientBrush>
        </Border.Background>
      </Border>
      <Border Background="{DynamicResource BackdropTintBrush}" />
      <!-- Hallow's Eve: a pale moon high on the right, and three far-off bats crossing it. Faint, still, behind everything. -->
      <!-- Hallow's Eve: a pale moon high on the right with bats drifting across it, a little mist along the bottom and
           a few embers rising on the left. Faint, behind everything; it moves only with Animations on (HalloweenMotion.axaml). -->
      <Canvas Classes="halloween-only" Width="320" Height="230" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,30,90,0">
        <Ellipse Classes="hw-moon-halo" Canvas.Left="110" Canvas.Top="-20" Width="176" Height="176" Opacity="0.10">
          <Ellipse.Fill>
            <RadialGradientBrush>
              <GradientStop Offset="0" Color="#FFFFC48A" />
              <GradientStop Offset="1" Color="#00FFC48A" />
            </RadialGradientBrush>
          </Ellipse.Fill>
        </Ellipse>
        <Ellipse Classes="hw-moon" Canvas.Left="150" Canvas.Top="20" Width="96" Height="96" Opacity="0.20">
          <Ellipse.Fill>
            <RadialGradientBrush Center="40%,40%" GradientOrigin="40%,40%" RadiusX="60%" RadiusY="60%">
              <GradientStop Offset="0" Color="#FFFFF4E0" />
              <GradientStop Offset="0.7" Color="#FFF2D9B0" />
              <GradientStop Offset="1" Color="#00F2D9B0" />
            </RadialGradientBrush>
          </Ellipse.Fill>
        </Ellipse>
        <Path Classes="hw-bat hw-bat1" Canvas.Left="96" Canvas.Top="78" Width="30" Height="12" Stretch="Uniform" Opacity="0.30" Fill="#FF050308"
              Data="M0 6 C3 2 6 2 8 5 C9 3 10 2 11 3 C12 2 13 3 14 5 C16 2 19 2 22 6 C19 5 17 6 16 8 C14 6 13 7 11 9 C9 7 8 6 6 8 C5 6 3 5 0 6 Z">
          <Path.RenderTransform><TranslateTransform /></Path.RenderTransform>
        </Path>
        <Path Classes="hw-bat hw-bat2" Canvas.Left="58" Canvas.Top="112" Width="20" Height="8" Stretch="Uniform" Opacity="0.24" Fill="#FF050308"
              Data="M0 6 C3 2 6 2 8 5 C9 3 10 2 11 3 C12 2 13 3 14 5 C16 2 19 2 22 6 C19 5 17 6 16 8 C14 6 13 7 11 9 C9 7 8 6 6 8 C5 6 3 5 0 6 Z">
          <Path.RenderTransform><TranslateTransform /></Path.RenderTransform>
        </Path>
        <Path Classes="hw-bat hw-bat3" Canvas.Left="132" Canvas.Top="128" Width="16" Height="7" Stretch="Uniform" Opacity="0.20" Fill="#FF050308"
              Data="M0 6 C3 2 6 2 8 5 C9 3 10 2 11 3 C12 2 13 3 14 5 C16 2 19 2 22 6 C19 5 17 6 16 8 C14 6 13 7 11 9 C9 7 8 6 6 8 C5 6 3 5 0 6 Z">
          <Path.RenderTransform><TranslateTransform /></Path.RenderTransform>
        </Path>
      </Canvas>
      <!-- Mist along the bottom -->
      <Border Classes="halloween-only hw-mist" Height="170" Width="2600" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-300,0,0,-30"
              IsHitTestVisible="False" Opacity="0.55">
        <Border.RenderTransform><TranslateTransform /></Border.RenderTransform>
        <Border.Background>
          <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Offset="0" Color="#00B8A6D0" />
            <GradientStop Offset="0.6" Color="#14B8A6D0" />
            <GradientStop Offset="1" Color="#24B8A6D0" />
          </LinearGradientBrush>
        </Border.Background>
      </Border>
      <!-- Embers rising on the left -->
      <Canvas Classes="halloween-only" Width="220" Height="260" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="250,0,0,20">
        <Ellipse Classes="hw-ember hw-ember1" Canvas.Left="20" Canvas.Top="240" Width="4" Height="4" Fill="#FFFF9F4D" Opacity="0">
          <Ellipse.RenderTransform><TranslateTransform /></Ellipse.RenderTransform>
        </Ellipse>
        <Ellipse Classes="hw-ember hw-ember2" Canvas.Left="70" Canvas.Top="245" Width="3" Height="3" Fill="#FFFFC48A" Opacity="0">
          <Ellipse.RenderTransform><TranslateTransform /></Ellipse.RenderTransform>
        </Ellipse>
        <Ellipse Classes="hw-ember hw-ember3" Canvas.Left="120" Canvas.Top="238" Width="5" Height="5" Fill="#FFFF8A3D" Opacity="0">
          <Ellipse.RenderTransform><TranslateTransform /></Ellipse.RenderTransform>
        </Ellipse>
        <Ellipse Classes="hw-ember hw-ember4" Canvas.Left="165" Canvas.Top="244" Width="3" Height="3" Fill="#FFFFB27A" Opacity="0">
          <Ellipse.RenderTransform><TranslateTransform /></Ellipse.RenderTransform>
        </Ellipse>
        <Ellipse Classes="hw-ember hw-ember5" Canvas.Left="200" Canvas.Top="240" Width="4" Height="4" Fill="#FFFF9F4D" Opacity="0">
          <Ellipse.RenderTransform><TranslateTransform /></Ellipse.RenderTransform>
        </Ellipse>
      </Canvas>
    </Panel>

    <!-- Navigation rail ====================================================================== -->
    <Border Grid.RowSpan="2" Classes="nav-rail">
      <DockPanel Margin="14,0,14,16">

        <!-- Brand; doubles as a window drag handle because the title bar is extended. -->
        <Border DockPanel.Dock="Top" Height="84" Background="Transparent" PointerPressed="OnTitleBarPointerPressed">
          <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Bottom" Margin="8,0,0,14">
            <!-- The logo: the original line sail (in the skin's colour) for Legacy, the SeaRaider logo for The Next Generation, the cobweb sail for Hallow's Eve. -->
            <Panel Width="28" Height="28">
              <Path Stretch="Uniform" IsVisible="{Binding IsLegacySkin}"
                    Stroke="{DynamicResource BiolumeBrush}" StrokeThickness="2"
                    StrokeLineCap="Round" StrokeJoin="Round"
                    Data="M12 3v12 M12 3l7.5 10.5H12 M3 19c2.2 0 2.2-1.6 4.5-1.6S9.7 19 12 19s2.2-1.6 4.5-1.6S18.7 19 21 19" />
              <Panel IsVisible="{Binding !IsLegacySkin}">
                <Image Classes="ngen-logo" Stretch="Uniform" Source="/Assets/logo.png" RenderOptions.BitmapInterpolationMode="HighQuality" />
                <!-- Hallow's Eve: the orange cobweb sail -->
                <Image Classes="halloween-only" Stretch="Uniform" Source="/Assets/logo-halloween.png"
                       RenderOptions.BitmapInterpolationMode="HighQuality" />
              </Panel>
            </Panel>
            <TextBlock Classes="brand" Text="SeaRaider" FontSize="21" FontWeight="Bold" VerticalAlignment="Center" />
          </StackPanel>
        </Border>

        <!-- Settings pinned to the bottom of the rail. -->
        <Button DockPanel.Dock="Bottom" Classes="bare" Command="{Binding OpenSettingsCommand}" Padding="14,10">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <Path Width="20" Height="20" Stretch="Uniform" Data="{Binding SettingsItem.Icon}"
                  Stroke="{DynamicResource MistBrush}" StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round" />
            <TextBlock Text="Settings" FontSize="15" Foreground="{DynamicResource MistBrush}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>

        <!-- Friends & Chat, above Settings: online count and a badge for requests / unread messages. -->
        <Button DockPanel.Dock="Bottom" Classes="bare" Command="{Binding Friends.ToggleCommand}" Padding="14,10"
                IsVisible="{Binding Friends.IsEnabled}" ToolTip.Tip="Friends &amp; Chat (Ctrl+Shift+F)">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <Path Width="20" Height="20" Stretch="Uniform" Data="{Binding FriendsIcon}"
                  Stroke="{DynamicResource MistBrush}" StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round" />
            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="Friends" FontSize="15" Foreground="{DynamicResource MistBrush}" />
              <TextBlock Classes="muted" FontSize="11" Text="{Binding Friends.OnlineSummary}" />
            </StackPanel>
            <Border Grid.Column="2" Classes="unread" VerticalAlignment="Center" IsVisible="{Binding Friends.HasBadge}">
              <TextBlock Text="{Binding Friends.BadgeCount}" />
            </Border>
          </Grid>
        </Button>

        <ListBox Classes="rail" Margin="0,8,0,0"
                 ItemsSource="{Binding NavItems}"
                 SelectedItem="{Binding SelectedNav}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:NavItem">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <!-- The bright bar: only on the page you're on (Theme.axaml shows it for the selected page). It stays inside its row and
                     has no glow, so nothing is left behind on the screen when you change pages. -->
                <Border Classes="rail-marker" Width="3" Height="18" CornerRadius="2" Margin="0"
                        Background="{DynamicResource BiolumeBrush}" />
                <Path Width="20" Height="20" Stretch="Uniform" Data="{Binding Icon}"
                      Stroke="{Binding $parent[ContentPresenter].Foreground}"
                      StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" />
                <TextBlock Text="{Binding Label}" FontSize="15" VerticalAlignment="Center" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- Page area ============================================================================ -->
    <Grid Grid.Column="1" RowDefinitions="44,Auto,*">
      <!-- Extended title bar: drag region + back. Caption buttons sit at the top right. -->
      <Border Background="Transparent" PointerPressed="OnTitleBarPointerPressed">
        <Button Classes="quiet" Margin="28,8,0,0" Padding="12,4" HorizontalAlignment="Left" VerticalAlignment="Center"
                IsVisible="{Binding CanGoBack}" Command="{Binding GoBackCommand}" Content="Back" />
      </Border>

      <StackPanel Grid.Row="1" Margin="32,0,32,0" Spacing="8">
        <Border Classes="error-banner" Margin="0,0,0,8" IsVisible="{Binding HasError}">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="{DynamicResource CoralBrush}" />
            <Button Grid.Column="1" Classes="link" Content="Dismiss" Command="{Binding DismissErrorCommand}" />
          </Grid>
        </Border>

        <!-- A game finished installing: try it, then its setup files can go. -->
        <Border Classes="notice-banner" Margin="0,0,0,8" IsVisible="{Binding HasCleanupOffer}">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <Path Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,12,0"
                  Stroke="{DynamicResource BiolumeBrush}" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round"
                  Data="M20 6 9 17l-5-5" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
              <TextBlock FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding CleanupTitle}" />
              <TextBlock Classes="muted small" TextWrapping="Wrap" Text="{Binding CleanupText}" />
            </StackPanel>
            <Panel Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center">
              <!-- Just installed: try it first -->
              <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding CleanupShowTry}">
                <Button Classes="quiet" Content="Keep them" Command="{Binding KeepSetupFilesCommand}"
                        ToolTip.Tip="Keep the setup files and don't ask again" />
                <Button Classes="quiet" Content="Delete now" Command="{Binding DeleteSetupFilesCommand}"
                        ToolTip.Tip="Delete them without trying the game first" />
                <Button Classes="primary" Content="Play now" Command="{Binding PlayToTryCommand}" />
              </StackPanel>
              <!-- Played: did it work? -->
              <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding CleanupShowWorked}">
                <Button Classes="quiet" Content="Not yet" Command="{Binding AskLaterCommand}"
                        ToolTip.Tip="Ask again next time the game is closed" />
                <Button Classes="quiet" Content="Keep them" Command="{Binding KeepSetupFilesCommand}" />
                <Button Classes="primary" Content="It works, delete them" Command="{Binding DeleteSetupFilesCommand}" />
              </StackPanel>
              <!-- Deleting failed -->
              <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding CleanupFailed}">
                <Button Classes="quiet" Content="Later" Command="{Binding AskLaterCommand}" />
                <Button Classes="quiet" Content="Open folder" Command="{Binding OpenSetupFolderCommand}" />
                <Button Classes="primary" Content="Try again" Command="{Binding DeleteSetupFilesCommand}" />
              </StackPanel>
            </Panel>
          </Grid>
        </Border>

        <!-- A new SeaRaider version is out -->
        <Border Classes="notice-banner" Margin="0,0,0,8" DataContext="{Binding Updates}" x:DataType="vm:UpdateViewModel"
                IsVisible="{Binding HasUpdate}">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <Path Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,12,0"
                  Stroke="{DynamicResource BiolumeBrush}" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round"
                  Data="M12 3v12m0 0-5-5m5 5 5-5M5 21h14" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
              <TextBlock FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding UpdateTitle}" />
              <TextBlock Classes="muted small" TextWrapping="Wrap" MaxHeight="60" IsVisible="{Binding HasNotes}" Text="{Binding UpdateNotes}" />
              <TextBlock Classes="muted small" TextWrapping="Wrap" IsVisible="{Binding IsInstalling}" Text="{Binding StatusText}" />
              <ProgressBar Classes="thin" Margin="0,4,0,0" IsVisible="{Binding IsInstalling}" Value="{Binding InstallProgress}" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" Margin="12,0,0,0" VerticalAlignment="Center"
                        IsEnabled="{Binding !IsInstalling}">
              <Button Classes="quiet" Content="Skip this version" Command="{Binding SkipCommand}" />
              <Button Classes="quiet" Content="Later" Command="{Binding LaterCommand}" />
              <Button Classes="primary" Content="Update and restart" Command="{Binding InstallCommand}" IsVisible="{Binding CanInstall}" />
            </StackPanel>
          </Grid>
        </Border>

        <!-- Just restarted after an update -->
        <Border Classes="notice-banner" Margin="0,0,0,8" DataContext="{Binding Updates}" x:DataType="vm:UpdateViewModel"
                IsVisible="{Binding JustUpdated}">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock FontWeight="SemiBold" VerticalAlignment="Center" Text="{Binding StatusText}" />
            <Button Grid.Column="1" Classes="link" Content="OK" Command="{Binding DismissUpdatedCommand}" />
          </Grid>
        </Border>

        <!-- A wishlisted game showed up in the store -->
        <Border Classes="notice-banner" Margin="0,0,0,8" IsVisible="{Binding HasWishlistNotice}">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <Border Width="92" Height="43" CornerRadius="6" ClipToBounds="True" Margin="0,0,14,0" VerticalAlignment="Center"
                    Background="{DynamicResource CoverPlaceholderBrush}">
              <Panel>
                <Path Width="18" Height="18" Stretch="Uniform" Fill="{DynamicResource CoralBrush}" Data="M12 20.5s-7.5-4.6-9.2-9.3C1.6 7.8 3.9 4.5 7.3 4.5c2 0 3.6 1.1 4.7 2.8 1.1-1.7 2.7-2.8 4.7-2.8 3.4 0 5.7 3.3 4.5 6.7-1.7 4.7-9.2 9.3-9.2 9.3Z" />
                <Image Stretch="UniformToFill" img:ImageLoader.Source="{Binding WishlistNoticeImage}" />
              </Panel>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
              <TextBlock FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding WishlistNoticeTitle}" />
              <TextBlock Classes="muted small" Text="It's ready to download now." />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" Margin="12,0,0,0" VerticalAlignment="Center">
              <Button Classes="quiet" Content="Later" Command="{Binding DismissWishlistNoticeCommand}" />
              <Button Classes="primary" Content="View in store" Command="{Binding ViewWishlistGameCommand}" />
            </StackPanel>
          </Grid>
        </Border>

        <!-- A site asked for a human check: the verification window is open; downloads continue once it's done. -->
        <Border Classes="verify-banner" Margin="0,0,0,8" IsVisible="{Binding HasVerificationPrompt}">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <Path Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,12,0"
                  Stroke="{DynamicResource BrassBrush}" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round"
                  Data="M12 3 4 6v6c0 4.4 3.4 8.4 8 9 4.6-.6 8-4.6 8-9V6l-8-3Zm-3 9 2 2 4-4" />
            <TextBlock Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding VerificationText}" />
            <Button Grid.Column="2" Classes="quiet" Margin="12,0,0,0" Content="Show window"
                    Command="{Binding ShowVerificationWindowCommand}" />
          </Grid>
        </Border>
      </StackPanel>

      <TransitioningContentControl Grid.Row="2" Content="{Binding CurrentPage}">
        <TransitioningContentControl.PageTransition>
          <CrossFade Duration="0:0:0.12" />
        </TransitioningContentControl.PageTransition>
      </TransitioningContentControl>
    </Grid>

    <!-- Friends & Chat: its own column at the right. Opening it grows the column smoothly, so the pages (and the download
         bar) slide left to make room instead of being covered; the panel's content rides in with its left edge. ======== -->
    <Border Grid.Column="2" Grid.RowSpan="2" Classes="friends-host" Classes.open="{Binding Friends.IsOpen}"
            IsVisible="{Binding Friends.IsEnabled}" ClipToBounds="True" HorizontalAlignment="Left" ZIndex="5">
      <views:FriendsListOverlay DataContext="{Binding Friends}" Width="360" HorizontalAlignment="Left" />
    </Border>

    <!-- New message toast (while the friends panel is closed) -->
    <Button Grid.Column="1" Classes="toast" ZIndex="6" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,24"
            IsVisible="{Binding Friends.HasToast}" Command="{Binding Friends.OpenToastCommand}">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <Path Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" Stroke="{DynamicResource BiolumeBrush}"
              StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round"
              Data="M4 5h16v11H9l-5 4V5Z" />
        <TextBlock Text="{Binding Friends.Toast}" TextWrapping="Wrap" MaxWidth="300" VerticalAlignment="Center" />
      </StackPanel>
    </Button>

    <!-- Download status bar (visible while anything is queued, downloading or extracting) ======= -->
    <Border Grid.Row="1" Grid.Column="1" Classes="status-bar" IsVisible="{Binding HasActiveDownloads}">
      <DockPanel>
        <ProgressBar DockPanel.Dock="Top" Classes="thin" CornerRadius="0"
                     Value="{Binding DownloadBarPercent}" IsIndeterminate="{Binding DownloadBarIndeterminate}" />
        <Grid ColumnDefinitions="*,Auto" Margin="32,10,32,12">
          <StackPanel Spacing="2">
            <TextBlock Text="{Binding DownloadBarTitle}" FontWeight="SemiBold" />
            <TextBlock Classes="muted small" Text="{Binding DownloadBarDetail}" />
          </StackPanel>
          <Button Grid.Column="1" Classes="link" Content="Open downloads" VerticalAlignment="Center"
                  Command="{Binding OpenDownloadsCommand}" />
        </Grid>
      </DockPanel>
    </Border>

    <!-- Modal dialog overlay (pre-download options…) ======================================== -->
    <Panel Grid.ColumnSpan="3" Grid.RowSpan="2" ZIndex="10"
           IsVisible="{Binding Dialogs.Current, Converter={x:Static ObjectConverters.IsNotNull}}">
      <Border Background="#C2030A12" />
      <Border Classes="panel dialog" Padding="0" Width="640" MaxHeight="780" Margin="24"
              HorizontalAlignment="Center" VerticalAlignment="Center" ClipToBounds="True">
        <ContentControl Content="{Binding Dialogs.Current}" />
      </Border>
    </Panel>
  </Grid>

  <!-- Coming-soon page: pops out over the blurred window. Click outside, the ×, or Esc closes it. -->
  <Panel x:Name="UpcomingOverlay" IsVisible="{Binding Upcoming.IsPopoutOpen}" Background="#B302070D"
         PointerPressed="OnUpcomingBackdropPressed">
    <Grid MaxWidth="1040" Margin="48,56,48,40" HorizontalAlignment="Center" VerticalAlignment="Center">
      <!-- DataContext is bound here (window's type); everything inside is typed as the selected game. -->
      <Border Classes="popout" DataContext="{Binding Upcoming.Selected}">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" x:DataType="vm:UpcomingCardViewModel">
          <StackPanel>
            <!-- Hero: the big picture with the title over it -->
            <views:AspectRatioBox Ratio="2.4">
              <Grid>
                <Border Background="{DynamicResource CoverPlaceholderBrush}" />
                <views:FitImage Url="{Binding HeroImageUrl}" />
                <Border>
                  <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                      <GradientStop Offset="0.35" Color="#00000000" />
                      <GradientStop Offset="1" Color="#F20F2131" />
                    </LinearGradientBrush>
                  </Border.Background>
                </Border>
                <StackPanel VerticalAlignment="Bottom" Margin="34,0,34,22" Spacing="8">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Border Classes="chip accent"><TextBlock Text="COMING SOON" /></Border>
                    <Border Classes="chip" Background="{DynamicResource MediaChipBrush}"><TextBlock Text="{Binding ReleaseText}" /></Border>
                  </StackPanel>
                  <TextBlock Classes="display" FontSize="42" LineHeight="48" Text="{Binding Title}" TextWrapping="Wrap" />
                </StackPanel>
              </Grid>
            </views:AspectRatioBox>

            <Grid ColumnDefinitions="*,28,300" Margin="34,10,34,34">
              <!-- About -->
              <StackPanel Spacing="14">
                <TextBlock Classes="h2" Text="About this game" />
                <TextBlock Classes="body" FontSize="14" LineHeight="23" TextWrapping="Wrap" Foreground="{DynamicResource FoamBrush}"
                           IsVisible="{Binding HasDescription}" Text="{Binding Description}" />
                <TextBlock Classes="muted" TextWrapping="Wrap" IsVisible="{Binding !HasDescription}"
                           Text="The site hasn't said much about this one yet. Wishlist it and SeaRaider will tell you when it can be downloaded." />
                <ItemsControl ItemsSource="{Binding Tags}" IsVisible="{Binding HasTags}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="sys:String">
                      <Border Classes="chip" Margin="0,0,6,6"><TextBlock Text="{Binding}" /></Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <!-- Facts and the wishlist button -->
              <StackPanel Grid.Column="2" Spacing="16">
                <Border Classes="pill" HorizontalAlignment="Stretch">
                  <StackPanel Spacing="2">
                    <TextBlock Classes="pill-label" Text="Release" />
                    <TextBlock Classes="pill-value" Text="{Binding ReleaseText}" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
                <Border Classes="pill" HorizontalAlignment="Stretch" IsVisible="{Binding HasDeveloper}">
                  <StackPanel Spacing="2">
                    <TextBlock Classes="pill-label" Text="Developer" />
                    <TextBlock Classes="pill-value" Text="{Binding Developer}" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>

                <Border Classes="glow">
                  <Button Classes="primary wish-big" Classes.on="{Binding IsWishlisted}" Command="{Binding ToggleWishlistCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <Path Data="M12 20.5s-7.5-4.6-9.2-9.3C1.6 7.8 3.9 4.5 7.3 4.5c2 0 3.6 1.1 4.7 2.8 1.1-1.7 2.7-2.8 4.7-2.8 3.4 0 5.7 3.3 4.5 6.7-1.7 4.7-9.2 9.3-9.2 9.3Z" VerticalAlignment="Center" />
                      <TextBlock VerticalAlignment="Center" Text="{Binding WishlistLabel}" />
                    </StackPanel>
                  </Button>
                </Border>
                <TextBlock Classes="muted small" TextWrapping="Wrap"
                           Text="You'll get a notice when it shows up in your store, ready to download." />
                <StackPanel Spacing="6">
                  <Button Classes="link" HorizontalAlignment="Left" Content="Open the game's page" IsVisible="{Binding HasPage}"
                          Command="{Binding OpenPageCommand}" />
                  <Button Classes="link" HorizontalAlignment="Left" Content="See your wishlist" Command="{Binding OpenWishlistCommand}" />
                  <TextBlock Classes="muted small" Text="{Binding SourceText}" />
                </StackPanel>
              </StackPanel>
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </Border>
      <Button Classes="popout-close" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="14"
              Command="{Binding Upcoming.ClosePopoutCommand}" ToolTip.Tip="Close (Esc)">
        <Path Data="M6 6 18 18 M18 6 6 18" />
      </Button>
    </Grid>
  </Panel>

  <!-- Trailer player overlay: the video in the window, over a dark backdrop. Click outside or press Esc to shrink it. -->
  <!-- Minimized (Trailer.IsMinimized): the same panel shrinks into the bottom-right corner (styles above), so the video keeps
       playing in the same browser while the app is used around it. Full screen (Trailer.IsFullScreen): only the video. -->
  <Panel x:Name="TrailerOverlay" IsVisible="{Binding Trailer.IsOpen}" Classes.mini="{Binding Trailer.IsMinimized}"
         Classes.fullscreen="{Binding Trailer.IsFullScreen}" PointerPressed="OnTrailerBackdropPressed">
    <Grid x:Name="TrailerLayout" ColumnDefinitions="*,Auto">
    <views:AspectRatioBox x:Name="TrailerFrame" Ratio="1.7777778" HorizontalAlignment="Center" VerticalAlignment="Center">
      <DockPanel>
        <!-- Mini-player bar: title, back to full size, close -->
        <!-- "+ Stream": what to do next -->
        <Grid DockPanel.Dock="Top" Height="34" ColumnDefinitions="*,Auto" IsVisible="{Binding Trailer.IsPickingAlongside}"
              Background="{DynamicResource BiolumeBrush}">
          <TextBlock Margin="10,0" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#FF0A0A0A"
                     Text="Pick a stream to add: click any box on Media" TextTrimming="CharacterEllipsis" />
          <Button Grid.Column="1" Classes="link" Padding="8,0" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="#FF0A0A0A"
                  Content="Cancel" Command="{Binding Trailer.CancelPickingCommand}" />
        </Grid>
        <Grid DockPanel.Dock="Top" Height="36" ColumnDefinitions="*,Auto,Auto" IsVisible="{Binding Trailer.IsMinimized}"
              Background="{DynamicResource PlayerBarBrush}">
          <TextBlock Margin="10,0" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                     Text="{Binding Trailer.Current.Title, FallbackValue=''}" />
          <Button Grid.Column="1" Classes="link" Padding="8,0" VerticalAlignment="Center" Content="⤢ Expand"
                  Command="{Binding Trailer.RestoreCommand}" ToolTip.Tip="Back to full size" />
          <Button Grid.Column="2" Classes="link" Padding="8,0" Margin="0,0,6,0" VerticalAlignment="Center" Content="✕"
                  Command="{Binding Trailer.CloseCommand}" ToolTip.Tip="Close" />
        </Grid>
        <!-- The bar above the video: title, then Invite · Chat · Bet slip · Minimize · Close -->
        <Grid DockPanel.Dock="Top" Height="52" ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto,Auto,Auto" Background="Transparent"
              IsVisible="{Binding Trailer.ShowPlayerHeader}">
          <TextBlock Classes="h2" FontSize="20" VerticalAlignment="Center" Margin="2,0,12,0" TextTrimming="CharacterEllipsis"
                     Text="{Binding Trailer.Current.Title, FallbackValue=''}" />
          <!-- Watch along: whose player this follows -->
          <Border Grid.Column="1" Classes="follow-banner" Margin="8,0,0,0" VerticalAlignment="Center"
                  IsVisible="{Binding WatchTogether.IsFollowing}">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Text="{Binding WatchTogether.FollowText}" />
              <Button Classes="link" FontSize="12" Padding="0" VerticalAlignment="Center" Content="Stop"
                      Command="{Binding WatchTogether.StopFollowingCommand}" ToolTip.Tip="Keep watching on your own" />
            </StackPanel>
          </Border>
          <!-- Invite friends to watch this with you -->
          <Button Grid.Column="2" Classes="quiet player-bar"
                  IsVisible="{Binding Friends.IsEnabled}" ToolTip.Tip="Invite a friend to watch this with you">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Path Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Stroke="{DynamicResource FoamBrush}"
                    StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round"
                    Data="M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm-7 10v-1a6 6 0 0 1 6-6h2a6 6 0 0 1 6 6v1M19 8v6M16 11h6" />
              <TextBlock Text="Invite" VerticalAlignment="Center" />
            </StackPanel>
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedRight">
                <StackPanel Width="280" Spacing="8">
                  <TextBlock FontWeight="SemiBold" Text="Watch this with a friend" />
                  <TextBlock Classes="muted small" TextWrapping="Wrap"
                             Text="They get an invite in chat; Watch along opens it where you are and keeps their player with yours." />
                  <TextBlock Classes="muted small" TextWrapping="Wrap" IsVisible="{Binding WatchTogether.HasNoInviteTargets}"
                             Text="No friends yet. Add someone with their friend code in the Friends panel (Ctrl+Shift+F)." />
                  <ItemsControl ItemsSource="{Binding WatchTogether.InviteTargets}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="services:WatchInviteTargetViewModel">
                        <Button Classes="mirror-option" Margin="0,0,0,4" Command="{Binding InviteCommand}">
                          <Grid ColumnDefinitions="Auto,*,Auto">
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,10,0"
                                     Fill="{DynamicResource BiolumeBrush}" IsVisible="{Binding IsOnline}" />
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,10,0"
                                     Fill="{DynamicResource LineBrush}" IsVisible="{Binding !IsOnline}" />
                            <StackPanel Grid.Column="1" Spacing="1">
                              <TextBlock FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                              <TextBlock Classes="muted small" Text="{Binding Status}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Classes="small" VerticalAlignment="Center" Margin="10,0,0,0"
                                       Foreground="{DynamicResource BiolumeBrush}" Text="Invite" />
                          </Grid>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Classes="brass small" TextWrapping="Wrap" IsVisible="{Binding WatchTogether.HasInviteStatus}"
                             Text="{Binding WatchTogether.InviteStatus}" />
                </StackPanel>
              </Flyout>
            </Button.Flyout>
          </Button>
          <!-- Live chat with everyone watching this -->
          <!-- Multi-view: another stream next to this one -->
          <Button Grid.Column="3" Classes="quiet player-bar" Command="{Binding Trailer.AddStreamCommand}"
                  IsVisible="{Binding Trailer.CanAddAlongside}"
                  ToolTip.Tip="Watch another stream next to this one (pick it on Media; up to 4 at once)">
            <TextBlock Text="＋ Stream" VerticalAlignment="Center" />
          </Button>
          <Button Grid.Column="4" Classes="quiet player-bar" Classes.selected="{Binding EventChat.IsOpen}"
                  Command="{Binding EventChat.ToggleCommand}" ToolTip.Tip="Chat with everyone in SeaRaider watching this">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="{Binding EventChat.ButtonText}" VerticalAlignment="Center" />
              <Border Classes="unread" IsVisible="{Binding EventChat.HasUnread}" VerticalAlignment="Center">
                <TextBlock Text="{Binding EventChat.Unread}" />
              </Border>
            </StackPanel>
          </Button>
          <!-- Bet slip beside the video -->
          <Button Grid.Column="5" Classes="quiet player-bar" Classes.selected="{Binding Trailer.IsBetSlipOpen}"
                  Command="{Binding Trailer.ToggleBetSlipCommand}" ToolTip.Tip="Show or hide the bet slip beside the video"
                  IsVisible="{Binding Trailer.ShowBetSlipButton}">
            <TextBlock Text="Bet slip" VerticalAlignment="Center" />
          </Button>
          <Button Grid.Column="6" Classes="quiet player-bar" Command="{Binding Trailer.MinimizeCommand}"
                  ToolTip.Tip="Keep playing in a corner while you use the app (Esc)">
            <TextBlock Text="▁" VerticalAlignment="Center" />
          </Button>
          <Button Grid.Column="7" Classes="quiet player-bar" Command="{Binding Trailer.CloseCommand}" ToolTip.Tip="Close">
            <Path Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center"
                  Stroke="{DynamicResource FoamBrush}" StrokeThickness="2" StrokeLineCap="Round"
                  Data="M6 6 18 18 M18 6 6 18" />
          </Button>
        </Grid>
        <!-- The player (a native browser window) is put here from code-behind for each trailer. -->
        <Border x:Name="TrailerSlot" Background="Black" ClipToBounds="True" />
      </DockPanel>
    </views:AspectRatioBox>
    <!-- Beside the video: the live chat and the bet slip (one above the other when both are open). Never in the corner or
         in full screen. -->
    <Panel x:Name="SideArea" Grid.Column="1">
    <Grid Width="360" Margin="16,52,0,0" RowDefinitions="2*,12,3*" IsVisible="{Binding EventChat.ShowSidePanel}">
      <!-- Live chat: everyone in SeaRaider watching this event -->
      <Border Classes="side-card" IsVisible="{Binding EventChat.IsOpen}" Grid.RowSpan="{Binding EventChat.ChatRowSpan}">
        <DockPanel>
          <Grid DockPanel.Dock="Top" Height="40" Margin="14,0,8,0" ColumnDefinitions="*,Auto">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <Ellipse Width="7" Height="7" Fill="#FFE5484D" VerticalAlignment="Center" />
              <TextBlock FontWeight="SemiBold" FontSize="14" Text="Live chat" VerticalAlignment="Center" />
              <TextBlock Classes="muted small" Text="{Binding EventChat.WatchingText}" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
              <!-- Who's watching: click a name to message them (friends) or add them -->
              <Button Classes="link" FontSize="12" VerticalAlignment="Center" Content="{Binding EventChat.ViewersButtonText}"
                      Command="{Binding EventChat.ToggleViewersCommand}" ToolTip.Tip="Who's watching" />
              <Button Classes="link" FontSize="12" VerticalAlignment="Center" Content="Hide" Command="{Binding EventChat.ToggleCommand}" />
            </StackPanel>
          </Grid>
          <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource PlayerCardLineBrush}" />
          <Border DockPanel.Dock="Bottom" Padding="8" Background="{DynamicResource PlayerCardFootBrush}">
            <Grid ColumnDefinitions="*,Auto">
              <TextBox Text="{Binding EventChat.Draft}" Watermark="Say something…" MaxLength="300"
                       IsEnabled="{Binding EventChat.CanChat}">
                <TextBox.KeyBindings>
                  <KeyBinding Gesture="Enter" Command="{Binding EventChat.SendCommand}" />
                </TextBox.KeyBindings>
              </TextBox>
              <Button Grid.Column="1" Classes="primary" Margin="6,0,0,0" Padding="12,6" Content="Send"
                      Command="{Binding EventChat.SendCommand}" IsEnabled="{Binding EventChat.CanChat}" />
            </Grid>
          </Border>
          <TextBlock DockPanel.Dock="Bottom" Classes="coral small" TextWrapping="Wrap" Margin="12,4"
                     IsVisible="{Binding EventChat.HasError}" Text="{Binding EventChat.ErrorMessage}" />
          <Panel>
            <TextBlock Classes="muted small" TextWrapping="Wrap" Margin="14" IsVisible="{Binding EventChat.HasStatus}"
                       Text="{Binding EventChat.StatusText}" />
            <ScrollViewer x:Name="EventChatScroller" HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding !EventChat.ShowViewers}">
              <ItemsControl ItemsSource="{Binding EventChat.Lines}" Margin="12,8">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:EventChatLineViewModel">
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,5" FontSize="13" LineHeight="18">
                      <Run Text="{Binding Name}" FontWeight="SemiBold" Foreground="{Binding NameBrush}" />
                      <Run Text="  " />
                      <Run Text="{Binding Text}" />
                    </TextBlock>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
            <!-- The viewer list -->
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding EventChat.ShowViewers}" Background="{DynamicResource PlayerCardBrush}">
              <StackPanel Margin="8,8" Spacing="2">
                <TextBlock Classes="muted small" TextWrapping="Wrap" Margin="6,4" IsVisible="{Binding EventChat.HasNoViewerList}"
                           Text="Your friends relay only sends how many are watching. Update SeaRaider.Relay on the server to see who." />
                <ItemsControl ItemsSource="{Binding EventChat.Viewers}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:EventChatViewerViewModel">
                      <Button Classes="mirror-option" Margin="0,0,0,2" HorizontalAlignment="Stretch" IsEnabled="{Binding !IsMe}">
                        <Grid ColumnDefinitions="*,Auto">
                          <StackPanel Spacing="1">
                            <TextBlock FontWeight="SemiBold" FontSize="13" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Classes="muted small" Text="{Binding StateText}"
                                       IsVisible="{Binding StateText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                          </StackPanel>
                          <TextBlock Grid.Column="1" Classes="small" VerticalAlignment="Center" Foreground="{DynamicResource BiolumeBrush}"
                                     Text="⋯" IsVisible="{Binding !IsMe}" />
                        </Grid>
                        <Button.Flyout>
                          <MenuFlyout Placement="LeftEdgeAlignedTop">
                            <MenuItem Header="Message" Command="{Binding MessageCommand}" IsVisible="{Binding CanMessage}" />
                            <MenuItem Header="Add friend" Command="{Binding AddCommand}" IsVisible="{Binding CanAdd}" />
                            <MenuItem Header="{Binding StateText}" IsEnabled="False" IsVisible="{Binding ShowStateInMenu}" />
                          </MenuFlyout>
                        </Button.Flyout>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </ScrollViewer>
          </Panel>
        </DockPanel>
      </Border>
      <!-- Bet slip: the sportsbook (Settings › General › Bet slip). Put here from code-behind. -->
      <Border Classes="side-card" Grid.Row="{Binding EventChat.BetSlipRow}" Grid.RowSpan="{Binding EventChat.BetSlipRowSpan}"
              IsVisible="{Binding Trailer.IsBetSlipOpen}">
        <DockPanel>
          <Grid DockPanel.Dock="Top" Height="40" Margin="14,0,8,0" ColumnDefinitions="*,Auto">
            <TextBlock FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" Text="Bet slip" />
            <Button Grid.Column="1" Classes="link" FontSize="12" VerticalAlignment="Center" Content="Hide" Command="{Binding Trailer.ToggleBetSlipCommand}" />
          </Grid>
          <Border x:Name="BetSlipSlot" Background="{DynamicResource PlayerBetSlipBrush}" />
        </DockPanel>
      </Border>
    </Grid>
    </Panel>
    </Grid>
  </Panel>

  <!-- A shared title's page being read for its player (it opens in the player above when found) -->
  <Border IsVisible="{Binding Trailer.IsFinding}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,40"
          Padding="18,12" CornerRadius="10" Background="{DynamicResource PlayerBarBrush}" BorderBrush="{DynamicResource BiolumeBrush}" BorderThickness="1">
    <StackPanel Orientation="Horizontal" Spacing="12">
      <ProgressBar Classes="thin" Width="60" IsIndeterminate="True" VerticalAlignment="Center" />
      <TextBlock Text="{Binding Trailer.FindingText}" VerticalAlignment="Center" Foreground="{DynamicResource FoamBrush}" />
      <Button Classes="link" Content="Cancel" Command="{Binding Trailer.CloseCommand}" VerticalAlignment="Center" />
    </StackPanel>
  </Border>

  <!-- "Add me on SeaRaider" from someone's Discord status: are you sure? -->
  <Panel IsVisible="{Binding IsFriendLinkOpen}" Background="#B302070D">
    <Border Classes="panel dialog" Width="440" Padding="26,24" HorizontalAlignment="Center" VerticalAlignment="Center">
      <StackPanel Spacing="14">
        <TextBlock Classes="muted small" Text="FROM DISCORD" LetterSpacing="1.2" />
        <TextBlock FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding FriendLinkTitle}" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Classes="muted small" VerticalAlignment="Center" Text="Friend code" />
          <TextBlock FontFamily="Consolas,Menlo,monospace" VerticalAlignment="Center" Text="{Binding FriendLinkCode}" />
        </StackPanel>
        <TextBlock Classes="small" TextWrapping="Wrap" Text="{Binding FriendLinkMessage}"
                   IsVisible="{Binding FriendLinkMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="0,6,0,0">
          <Button Classes="quiet" Content="Cancel" Command="{Binding CloseFriendLinkCommand}" IsVisible="{Binding !IsFriendLinkDone}" />
          <Button Classes="primary" Content="Send friend request" Command="{Binding ConfirmFriendLinkCommand}"
                  IsVisible="{Binding CanConfirmFriendLink}" />
          <Button Classes="primary" Content="Done" Command="{Binding CloseFriendLinkCommand}" IsVisible="{Binding IsFriendLinkDone}" />
        </StackPanel>
      </StackPanel>
    </Border>
  </Panel>
  </Panel>
</Window>
