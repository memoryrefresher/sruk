<Project>
  <!--
    Central Package Management. Every project references packages WITHOUT a version;
    the version is pinned here so the whole solution stays consistent.
    See the README for checking newer releases.
  -->
  <ItemGroup Label="UI (Avalonia)">
    <PackageVersion Include="Avalonia" Version="11.2.3" />
    <PackageVersion Include="Avalonia.Desktop" Version="11.2.3" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="11.2.3" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="11.2.3" />
    <PackageVersion Include="Avalonia.Diagnostics" Version="11.2.3" />
    <!-- 11.1.5 is the last 11.x release of ItemsRepeater; it targets Avalonia >= 11.1 and runs on 11.2. -->
    <PackageVersion Include="Avalonia.Controls.ItemsRepeater" Version="11.1.5" />
    <PackageVersion Include="AsyncImageLoader.Avalonia" Version="3.3.0" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <!-- Captcha / verification window (Windows only; uses the WebView2 runtime built into Windows 10/11). -->
    <PackageVersion Include="Microsoft.Web.WebView2" Version="1.0.3912.50" />
    <!-- Discord status ("Playing … · via SeaRaider") over Discord's local connection. -->
    <PackageVersion Include="DiscordRichPresence" Version="1.2.1.24" />
  </ItemGroup>

  <ItemGroup Label="Core services">
    <PackageVersion Include="AngleSharp" Version="1.5.0" />
    <PackageVersion Include="LiteDB" Version="5.0.21" />
    <PackageVersion Include="MonoTorrent" Version="3.0.2" />
    <PackageVersion Include="SharpCompress" Version="0.48.0" />
  </ItemGroup>

  <ItemGroup Label="Hosting / DI / logging">
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="8.0.1" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="8.0.1" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Debug" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup Label="Tests">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageVersion Include="xunit" Version="2.9.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
</Project>
